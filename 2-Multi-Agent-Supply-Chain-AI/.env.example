# =====================================================================
# Multi-Agent Supply Chain AI System — configuration
# Copy to .env and fill in. NEVER commit .env.
# Tests never read .env; they use fakes.
# =====================================================================

# ---------------------------------------------------------------- app
ENV=local                         # local | dev | staging | prod
APP_NAME=supply-chain-ai
LOG_LEVEL=INFO
LOG_FORMAT=text                   # text (prints extra= fields) | json (containers)
CORS_ORIGINS=http://localhost:8000

# ---------------------------------------------------------------- LLM providers (OpenAI-compatible)
# Every provider is called through ChatOpenAI/OpenAIEmbeddings with a base_url.
EURI_API_KEY=
EURI_BASE_URL=https://api.euron.one/api/v1/euri
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Ordered fallback chains: provider:model,provider:model
# Agent-chain models must pass a real tool-call round-trip test before being listed (Gemini pitfall).
LLM_ANSWER_CHAIN=euri:gpt-4.1-mini,gemini:gemini-3.5-flash,groq:openai/gpt-oss-120b,groq:qwen/qwen3.8-27b
LLM_AGENT_CHAIN=euri:gpt-4.1-mini,groq:qwen/qwen3.8-27b,groq:openai/gpt-oss-120b
LLM_JUDGE_MODEL=euri:gpt-4.1-mini
LLM_TEMPERATURE=0.2               # validated to 0.2–0.5; the judge always uses 0
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=1500

# Embeddings cannot fall back (vectors are not comparable across models).
# Gemini embeddings keep search working even when the Euri wallet is empty.
# Changing the embedding model => new KB_COLLECTION + re-upload.
EMBEDDING_MODEL=gemini:gemini-embedding-001
EMBEDDING_DIMENSIONS=1536        # must equal the pgvector column size (<= 2000 for HNSW)
KB_COLLECTION=documents_gemini

# ---------------------------------------------------------------- database (Supabase Postgres + pgvector)
# Runtime: transaction pooler (6543) — the app disables prepared statements.
# Migrations / checkpointer setup: session pooler (5432).
# URL-encode special characters in the password (@ -> %40).
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:6543/postgres?sslmode=require
DATABASE_MIGRATION_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres?sslmode=require
DATABASE_POOL_SIZE=5

# ---------------------------------------------------------------- Supabase auth
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=         # browser-safe; used by the UI sign-in
SUPABASE_SECRET_KEY=              # server-only; used by scripts/set_role.py, never sent to the browser
SUPABASE_JWKS_URL=https://YOUR-PROJECT.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated

# ---------------------------------------------------------------- Redis
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------- web search
TAVILY_API_KEY=                   # empty = research agent uses the knowledge base only

# ---------------------------------------------------------------- RAG
RAG_TOP_K=5
RAG_RERANK_CANDIDATES=12
RAG_RERANK_IN_AGENT=false
MAX_UPLOAD_MB=20

# OCR for scanned PDFs / images
OCR_ENGINE=tesseract              # tesseract | vision_llm | off
OCR_LANGUAGES=eng
OCR_MIN_CONFIDENCE=60
OCR_VISION_MODEL=euri:gpt-4.1-mini

# ---------------------------------------------------------------- agents / human-in-the-loop
AGENT_RECURSION_LIMIT=25
AGENT_MAX_TOOL_ITERATIONS=4
AGENT_NODE_TIMEOUT_SECONDS=60
TOOL_TIMEOUT_SECONDS=10
APPROVAL_PO_VALUE_THRESHOLD=10000
APPROVAL_TTL_HOURS=24

# ---------------------------------------------------------------- guardrails
GUARDRAIL_PROFILES=pii,hipaa      # compliance detector profiles
GUARDRAIL_INPUT_MODE=block        # off | flag | block
GUARDRAIL_CONTEXT_MODE=block
GUARDRAIL_OUTPUT_MODE=block
HALLUCINATION_GUARD_MODE=flag
MAX_QUERY_CHARS=4000
AUDIT_LOG_CONTENT=false

# ---------------------------------------------------------------- rate limits (per user, per minute)
RATE_LIMIT_CHAT=20
RATE_LIMIT_UPLOAD=10
RATE_LIMIT_DEFAULT=60

# ---------------------------------------------------------------- observability
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=supply-chain-ai

# ---------------------------------------------------------------- AWS (same region as the database)
AWS_REGION=ap-northeast-1
