          "refId": "A",
          "expr": "sum by (model, direction) (rate(finagent_llm_tokens_total[5m])) * 60",
          "legendFormat": "{{model}} {{direction}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
