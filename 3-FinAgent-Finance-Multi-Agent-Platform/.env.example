# =====================================================================
# FinAgent — environment template. Copy to .env and fill in.
# This file IS committed: keep it free of real values.
# No quotes needed, no spaces around "=". Empty = not set.
# =====================================================================

# ---------------------------------------------------------------- app
APP_ENV=local
# Synthetic market data, prices and news; the full demo works without external financial APIs
DEMO_MODE=true
LOG_LEVEL=INFO
# text (local) or json (containers)
LOG_FORMAT=text
API_PORT=8020
FRONTEND_PORT=3020
CORS_ORIGINS=http://localhost:3020,http://127.0.0.1:3020

# ---------------------------------------------------------------- LLM providers (OpenAI-compatible)
EURI_API_KEY=
EURI_BASE_URL=https://api.euron.one/api/v1/euri
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Optional providers (ADR-006)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Bedrock uses the AWS_* settings below

# ---------------------------------------------------------------- model chains
# Format provider:model,provider:model,... — first is primary, the rest are fallbacks.
LLM_ANSWER_CHAIN=euri:gpt-4.1-mini,gemini:gemini-3.8-flash,groq:openai/gpt-oss-120b
# Tool-calling agents: only models that passed scripts.check_models tool round trips.
# Gemini excluded (tool calls fail over the OpenAI-compatible API); groq gpt-oss-120b excluded
# (garbled tool arguments in live checks, 2026-10-08).
LLM_AGENT_CHAIN=euri:gpt-4.1-mini,groq:qwen/qwen3.8-27b,groq:openai/gpt-oss-20b
# Shorthand (base brief): if both are set they override both chains with a single model.
LLM_PROVIDER=
LLM_MODEL=
# 0.2–0.5
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------- agents
# LLM tool loop per agent (false = deterministic plans only, no LLM tokens for agents)
AGENT_LLM_TOOL_LOOP=true
AGENT_MAX_TOOL_ITERATIONS=2
# Narrative via the answer chain (false = deterministic narrative built from tool facts)
LLM_NARRATIVE=true
# LLM intent classification after Jev (false = Jev, then keyword routing; no LLM call)
LLM_ROUTING=true

# ---------------------------------------------------------------- token budgets (ADR-029)
# Hard ceiling for all LLM calls in one request; beyond it FinAgent answers deterministically.
LLM_REQUEST_TOKEN_BUDGET=12000
# Intent classification (LLM fallback after Jev)
LLM_CLASSIFY_MAX_INPUT_TOKENS=600
LLM_CLASSIFY_MAX_OUTPUT_TOKENS=60
# Each agent tool-selection step; each tool result shown back to the model
LLM_AGENT_MAX_INPUT_TOKENS=3000
LLM_AGENT_MAX_OUTPUT_TOKENS=300
LLM_TOOL_RESULT_MAX_TOKENS=450
# Final narrative (shorter than the minimum → deterministic narrative)
LLM_NARRATIVE_MAX_INPUT_TOKENS=2500
LLM_NARRATIVE_MAX_OUTPUT_TOKENS=450
LLM_NARRATIVE_MIN_OUTPUT_TOKENS=40

# ---------------------------------------------------------------- embeddings (bi-encoder)
EMBEDDING_PROVIDER=euri
EMBEDDING_MODEL=text-embedding-3-small
# Must equal the pgvector column size
EMBEDDING_DIMENSIONS=1536

# ---------------------------------------------------------------- re-ranking (cross-encoder)
# cross_encoder | llm | none
RERANKER=cross_encoder
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_TOP_N=12

# ---------------------------------------------------------------- chunking (docs/rag-architecture.md)
# auto | fixed | sliding_window | recursive | sentence_window | semantic | structure |
# parent_child | hierarchical | table | record | code | slide | multimodal | proposition
CHUNKING_STRATEGY=auto
# Vision-LLM captions for images/charts in the multimodal strategy
MULTIMODAL_CAPTIONS=false

# ---------------------------------------------------------------- vector store
# pgvector | qdrant | opensearch
VECTOR_STORE=pgvector
# Only for qdrant/opensearch, e.g. http://localhost:6333
VECTOR_DB_URL=

# ---------------------------------------------------------------- web search
TAVILY_API_KEY=

# ---------------------------------------------------------------- decision model (TypeSafe AI Jev, ADR-027)
# Fast typed decisions (routing, guardrail checks, approval triage). Without a key the app falls
# back to LLM structured output / deterministic rules.
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest
DECISION_TIMEOUT_SECONDS=5

# ---------------------------------------------------------------- Supabase
# Dashboard → Project Settings → API Keys
SUPABASE_URL=
# Publishable key (sb_publishable_...) — browser-safe
SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) — server only (demo-user script)
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# ---------------------------------------------------------------- Postgres
# supabase | local (docker compose Postgres)
DATABASE_TARGET=supabase
# Optional full URL; if empty it is built from the DB_* parts with the password URL-encoded.
DATABASE_URL=
# Dashboard → Connect → Transaction pooler / Session pooler
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=postgres
# Transaction pooler — the app (prepared statements disabled)
DB_PORT_TRANSACTION=6543
# Session pooler — Alembic migrations and the LangGraph checkpointer
DB_PORT_SESSION=5432
# Integration tests only (local container, see CLAUDE.md); leave empty otherwise
TEST_DATABASE_URL=

# ---------------------------------------------------------------- Redis
# docker compose provides it (not published to the host)
REDIS_URL=redis://127.0.0.1:6390/0
# false = in-process memory/limits only (Redis failures fall back to in-process automatically)
REDIS_ENABLED=true

# ---------------------------------------------------------------- Rate limits (per user per minute)
RATE_LIMIT_CHAT=20
RATE_LIMIT_ANALYZE=20
RATE_LIMIT_READ=300
RATE_LIMIT_UPLOAD=10

# ---------------------------------------------------------------- MCP
# inmemory | http
MCP_TRANSPORT=inmemory
# MCP_TRANSPORT=http: per-server URL ({server}, {port}); servers listen on 8021–8026
# (`uv run python -m src.mcp.run all`). In Docker Compose: http://mcp-{server}:{port}/mcp
MCP_URL_TEMPLATE=http://127.0.0.1:{port}/mcp
# Shared secret the API gateway sends to the MCP servers (required for http transport)
MCP_SERVICE_TOKEN=

# ---------------------------------------------------------------- ML
MLFLOW_URL=sqlite:///mlruns/mlflow.db
ML_FRAUD_MODEL_VERSION=latest
ML_RISK_MODEL_VERSION=latest
ML_FORECAST_MODEL_VERSION=latest

# ---------------------------------------------------------------- approvals and safety
# Orders above this value (USD) need human approval
APPROVAL_VALUE_THRESHOLD=250000
APPROVAL_TTL_HOURS=24
MAX_INPUT_CHARS=4000

# ---------------------------------------------------------------- demo users (Stage 8)
DEMO_USER_PASSWORD=

# ---------------------------------------------------------------- observability
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=finagent
# e.g. http://localhost:4317 ; empty = tracing to logs only
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=finagent-api
# Optional bearer token for GET /metrics (Prometheus sends it); blank = open on the network
METRICS_TOKEN=

# ---------------------------------------------------------------- AWS (not needed locally)
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
