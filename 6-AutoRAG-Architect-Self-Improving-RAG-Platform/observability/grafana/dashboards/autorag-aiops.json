{
  "__inputs": [],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.4.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    }
  ],
  "annotations": {
    "list": []
  },
  "description": "AutoRAG Architect -- AI Operations Dashboard (G-5 / Plan v4): agent cost by provider, latency p95 per agent, Unified Score trend, provider failover, cache hit/miss, token usage, budget utilization, adversarial pass rate",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "title": "System Overview",
      "url": "/d/autorag-overview",
      "type": "link",
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "Agent Cost by Provider (24h stacked)",
      "type": "barchart",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "currencyUSD",
          "custom": {
            "stacking": {
              "mode": "value"
            }
          }
        }
      },
      "options": {
        "barWidth": 0.7,
        "groupWidth": 0.7,
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "sum by (agent_name, provider) (increase(autorag_agent_cost_usd_total[24h]))",
          "legendFormat": "{{agent_name}} / {{provider}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Agent Latency p95 (ms)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1500
              },
              {
                "color": "red",
                "value": 3000
              }
            ]
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (agent_name, le) (rate(autorag_agent_latency_ms_bucket[5m])))",
          "legendFormat": "{{agent_name}} p95",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Unified Score Trend",
      "description": "GAP: autorag_unified_score is not in app/metrics.py's Rule 86 registry -- no live data source today. Real value is persisted per-run in evaluation_runs.unified_score / MLflow.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "#5EEAD4",
            "mode": "fixed"
          },
          "unit": "short",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.7
              },
              {
                "color": "green",
                "value": 0.85
              }
            ]
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "expr": "autorag_org_score_avg",
          "legendFormat": "Unified Score",
          "refId": "A"
        },
        {
          "expr": "0.85",
          "legendFormat": "Deploy Gate (0.85)",
          "refId": "B"
        },
        {
          "expr": "0.70",
          "legendFormat": "HITL Gate (0.70)",
          "refId": "C"
        }
      ]
    },
    {
      "id": 4,
      "title": "Provider Failover Events",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 40
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "sum by (from_provider, to_provider) (increase(autorag_provider_switch_total[1h]))",
          "legendFormat": "{{from_provider}} -> {{to_provider}}",
          "refId": "A"
        },
        {
          "expr": "sum by (provider) (increase(autorag_provider_failures_total[1h]))",
          "legendFormat": "Failures: {{provider}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 5,
      "title": "Cache Hit / Miss Ratio",
      "type": "piechart",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short"
        }
      },
      "options": {
        "pieType": "donut",
        "legend": {
          "displayMode": "table",
          "placement": "right"
        }
      },
      "targets": [
        {
          "expr": "sum(increase(autorag_cache_hits_total[24h]))",
          "legendFormat": "Hits",
          "refId": "A"
        },
        {
          "expr": "sum(increase(autorag_cache_misses_total[24h]))",
          "legendFormat": "Misses",
          "refId": "B"
        }
      ]
    },
    {
      "id": 6,
      "title": "Token Usage by Agent (24h stacked)",
      "type": "barchart",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 18,
        "x": 6,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short",
          "custom": {
            "stacking": {
              "mode": "value"
            }
          }
        }
      },
      "options": {
        "barWidth": 0.6,
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "sum by (agent_name, token_type) (increase(autorag_agent_tokens_total[24h]))",
          "legendFormat": "{{agent_name}} / {{token_type}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Budget Utilization",
      "type": "gauge",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.7
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "auto",
        "showThresholdLabels": true,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "expr": "sum(increase(autorag_agent_cost_usd_total[24h])) / 2.00",
          "legendFormat": "Pipeline Build Budget",
          "refId": "A"
        },
        {
          "expr": "autorag_cost_per_query_usd / 0.01",
          "legendFormat": "Per-Query Budget",
          "refId": "B"
        },
        {
          "expr": "sum(increase(autorag_agent_cost_usd_total[720h])) / (sum(increase(autorag_agent_cost_usd_total[720h] offset 720h)) * 1.20)",
          "legendFormat": "Monthly Cost Cap",
          "refId": "C"
        }
      ]
    },
    {
      "id": 8,
      "title": "Adversarial Pass Rate",
      "description": "GAP: autorag_adversarial_pass_rate is not in app/metrics.py's Rule 86 registry -- no live data source today. Real value is persisted per-run in evaluation_runs.adversarial_passed / MLflow.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.9
              },
              {
                "color": "green",
                "value": 1.0
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area"
      },
      "targets": [
        {
          "expr": "autorag_adversarial_pass_rate",
          "legendFormat": "Adversarial Pass Rate",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": [
    "autorag",
    "ai-ops",
    "plan-v4",
    "g5"
  ],
  "templating": {
    "list": [
      {
        "name": "org_id",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(autorag_org_queries_total, organization_id)",
        "label": "Organization",
        "multi": false,
        "includeAll": true,
        "allValue": ".*"
      }
    ]
  },
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "AutoRAG AI Operations",
  "uid": "autorag-aiops",
  "version": 1
}
