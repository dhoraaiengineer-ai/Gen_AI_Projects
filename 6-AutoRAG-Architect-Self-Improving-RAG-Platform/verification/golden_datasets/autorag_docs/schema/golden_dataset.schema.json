{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AutoRAG Golden Dataset — autorag_docs package",
  "description": "Schema for one benchmark question in the autorag_docs golden dataset package (20 questions, grounded in AutoRAG's own project documentation). See evaluation/golden_datasets/autorag_docs/metadata.json for dataset-level metadata and evaluation/golden_datasets/autorag_docs/reports/coverage_report.md for the coverage report. This package is one of several under evaluation/golden_datasets/ — see evaluation/golden_datasets/benchmark_registry.json for the full list.",
  "type": "object",
  "required": [
    "id",
    "version",
    "category",
    "difficulty",
    "question",
    "ground_truth_answer",
    "reference_context",
    "source_document",
    "section",
    "page_number",
    "review_status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^GT-[0-9]{3}$"
    },
    "version": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "Architecture",
        "Retrieval",
        "Ingestion",
        "Evaluation",
        "Agents",
        "Deployment",
        "Security",
        "Monitoring"
      ]
    },
    "subcategory": {
      "type": "string"
    },
    "question_type": {
      "type": "string",
      "enum": [
        "Fact",
        "Definition",
        "List",
        "Process",
        "Comparison",
        "Configuration",
        "Calculation",
        "Troubleshooting",
        "Multi-hop",
        "Summarization"
      ]
    },
    "difficulty": {
      "type": "string",
      "enum": ["Easy", "Medium", "Hard"]
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "ground_truth_answer": {
      "type": "string",
      "minLength": 1
    },
    "reference_context": {
      "type": "string",
      "minLength": 1
    },
    "source_document": {
      "type": "string"
    },
    "section": {
      "type": "string"
    },
    "page_number": {
      "type": ["integer", "null"]
    },
    "keywords": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 5,
      "maxItems": 10
    },
    "expected_citations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "page": { "type": ["integer", "null"] },
          "section": { "type": "string" }
        }
      }
    },
    "evaluation_notes": {
      "type": "string"
    },
    "review_status": {
      "type": "string",
      "enum": ["generated", "reviewed", "approved"]
    },
    "created_at": {
      "type": "string",
      "format": "date"
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    }
  }
}
