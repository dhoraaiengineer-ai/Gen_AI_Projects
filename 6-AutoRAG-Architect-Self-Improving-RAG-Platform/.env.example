# 🛡️═══════════════════════════════════════════════════════════════════════
#                    AutoRAG Architect — Root Environment Template
# ════════════════════════════════════════════════════════════════════════
#
# Version:        v4.0
# Updated:        17-Jul-2026
#
# ⚠️ THIS FILE IS SAFE TO COMMIT — every value below is a placeholder.
# Copy it to `.env` (and again into `autorag-server/.env` and
# `autorag-client/.env`), then self-serve your own real values -- see
# project_docs/MVP_VALIDATION_TASK.md, "Creating Your Own Test Environment"
# for the exact steps (free Supabase project + free Gemini/Groq API keys,
# ~15 minutes, no lead needed for local testing). Never fill in real
# secrets in this file, never commit the real `.env` it produces.
#
# Field names below are verified against `autorag-server/app/core/config.py`
# (`Settings`) as of 17-Jul-2026 — this is what the app actually reads, not
# a guess. If you find a variable here that config.py doesn't use, that's a
# real drift bug worth flagging, not a naming style choice.
#
# -----------------------------------------------------------------------------
# TEAM RULES
# -----------------------------------------------------------------------------
# 1. TESTING PHASE (current, as of 17-Jul-2026): each tester creates their OWN
#    free Supabase project + own free Gemini/Groq API keys and self-serves a
#    fully working, isolated environment. This is deliberate, not a gap --
#    Supabase's free tier is one project per account, so it cannot be shared
#    across many concurrent testers. Full step-by-step instructions:
#    project_docs/MVP_VALIDATION_TASK.md, "Creating Your Own Test Environment".
#    Nothing you set up this way touches anyone else's data or credentials.
# 2. Shared PRODUCTION/staging credentials remain lead-managed (Mahesh Kumar)
#    -- this self-serve rule applies to individual local testing
#    environments only, never to dev/staging/production infrastructure.
# 3. NEVER commit a real `.env` — only this `.env.example` template is
#    safe to commit.
# 4. Variables prefixed `NEXT_PUBLIC_` are exposed to the browser. Never put
#    a secret there — service-role keys, DB passwords, and JWT secrets must
#    never be `NEXT_PUBLIC_*`.
#
# 🛡️═══════════════════════════════════════════════════════════════════════


# ════════════════════════════════════════════════════════════════════════
# CORE
# ════════════════════════════════════════════════════════════════════════

ENVIRONMENT=local
# local | dev | staging | production

LOG_LEVEL=INFO
# DEBUG | INFO | WARNING | ERROR

JWT_SECRET_KEY=change-me-minimum-32-characters
# Generate a strong random secret. Never commit a real value.

PII_MASKING_ENABLED=true
# Always true unless deliberately debugging locally.

UNIFIED_SCORE_GATE=0.70
# Local/dev threshold. Production governance: autonomous deploy >= 0.85,
# HITL required 0.70-0.84, hard block < 0.70.

RATE_LIMIT_PER_MINUTE=60


# ════════════════════════════════════════════════════════════════════════
# SUPABASE — Database, Vector Store, Storage
# ════════════════════════════════════════════════════════════════════════
# Source: Supabase Dashboard -> Project Settings -> API
# SUPABASE_SERVICE_ROLE_KEY is BACKEND ONLY -- never expose to frontend.
# ════════════════════════════════════════════════════════════════════════

SUPABASE_URL=https://your-project-id.supabase.co

SUPABASE_SERVICE_ROLE_KEY=your-service-role-jwt-here
# BACKEND ONLY

SUPABASE_ANON_KEY=your-anon-key-jwt-here
# Safe for frontend

DATABASE_URL=postgresql+asyncpg://postgres:your-password@db.your-project-id.supabase.co:5432/postgres
# Default: Supabase Cloud direct (matches every real .env, no local Postgres
# needed). Only point this at a local connection string if you're
# deliberately running the local Postgres mirror
# (docker compose -f docker-compose.yml -f docker-compose.local.yml up) --
# see project_docs/MVP_VALIDATION_TASK.md's Launch Modes section.


# ════════════════════════════════════════════════════════════════════════
# AI PROVIDERS — provider-agnostic chat + embedding routing
# ════════════════════════════════════════════════════════════════════════
# As of 17-Jul-2026 the chat failover chain is fully configurable via
# CHAT_PROVIDER_ORDER (app/core/config.py's resolve_chat_provider_chain()).
# EURI remains the default/fallback transport when no provider-specific
# values are set below -- leaving everything in this section at its
# EURI-only defaults is a valid, working configuration.
# ════════════════════════════════════════════════════════════════════════

EURI_BASE_URL=https://api.euron.one/api/v1/euri
EURI_API_KEY=your-euri-key-here
# Single shared key covering the default LLM + embedding chain via EURI's
# OpenAI-compatible gateway -- unlike Gemini/Groq below, EURI has no public
# free self-serve tier, so this one genuinely comes from a project lead.
# SKIP THIS ENTIRELY for self-serve local testing: leave blank and use
# CHAT_PROVIDER_ORDER=groq,gemini with your own free Groq+Gemini keys
# instead (see the two sections below) -- EURI is not required.

# --- Optional: direct Gemini (chat fallback slot + all embeddings) ---
GEMINI_API_KEY=your-google-ai-studio-key-here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_CHAT_MODEL=gemini-flash-latest
# Use the rolling "-latest" alias, not a pinned dated model (e.g.
# gemini-2.5-flash) -- Google deprecates pinned models without notice;
# this exact class of bug broke every evaluation on 17-Jul-2026 until fixed.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- Optional: KiMi (fallback chat, via EURI) ---
KIMI_API_KEY=your-kimi-key-here
# KIMI_BASE_URL=
# KIMI_CHAT_MODEL=

# --- Optional: Groq (primary chat, direct -- no EURI fallback path exists
# for Groq, so both GROQ_BASE_URL and GROQ_API_KEY are required together
# if you set either) ---
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=your-groq-key-here
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# --- Chat failover order (comma-separated provider names) ---
CHAT_PROVIDER_ORDER=gemini,kimi,gemini
# Default chain (matches the ADR-approved architecture): Gemini Flash primary
# -> KiMi fallback -> Gemini last-resort, all routed through EURI unless the
# provider-specific *_BASE_URL values above are also set. To use Groq as
# primary chat with direct Gemini as fallback instead (this session's local
# dev setup): CHAT_PROVIDER_ORDER=groq,gemini

# --- Reranking (optional -- BGE local cross-encoder is the automatic
# fallback when this is empty, not an error) ---
COHERE_API_KEY=


# ════════════════════════════════════════════════════════════════════════
# NOTIFICATIONS
# ════════════════════════════════════════════════════════════════════════

SENDGRID_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# E.164 format, e.g. +1xxxxxxxxxx


# ════════════════════════════════════════════════════════════════════════
# REDIS / CACHE
# ════════════════════════════════════════════════════════════════════════

REDIS_URL=redis://localhost:6379/0
# Genuinely local in every mode. Docker: `docker compose up -d`.
# Windows without Docker: install Memurai (https://www.memurai.com/) instead
# -- runs as a background service automatically.


# ════════════════════════════════════════════════════════════════════════
# EXPERIMENT TRACKING
# ════════════════════════════════════════════════════════════════════════

MLFLOW_TRACKING_URI=http://localhost:5000


# ════════════════════════════════════════════════════════════════════════
# OBSERVABILITY (Docker "Full Docker" launch mode only)
# ════════════════════════════════════════════════════════════════════════

GRAFANA_USER=admin
GRAFANA_PASSWORD=set-a-strong-password-locally
# Never use the default admin password in production.


# ════════════════════════════════════════════════════════════════════════
# FRONTEND (reference only -- these actually live in autorag-client/.env)
# ════════════════════════════════════════════════════════════════════════
# NEXT_PUBLIC_* variables are exposed publicly in browser bundles.
# NEVER place secrets here.
# ════════════════════════════════════════════════════════════════════════

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-jwt-here
# Same value as SUPABASE_ANON_KEY above -- safe for frontend.
NEXT_PUBLIC_ANALYTICS_ENABLED=false


# 🛡️═══════════════════════════════════════════════════════════════════════
# FINAL SECURITY CHECKLIST — before pushing any code
# ════════════════════════════════════════════════════════════════════════
#
# [ ] Verify .env (the real, filled-in file) is NOT tracked by git
# [ ] Verify no real secrets appear anywhere in your diff (`git diff`)
# [ ] Verify NEXT_PUBLIC_* contains no secrets
# [ ] Verify service-role keys stay backend-only
#
# If a secret is accidentally committed: rotate it immediately, remove it
# from git history, and notify a project lead.
#
# 🛡️═══════════════════════════════════════════════════════════════════════
