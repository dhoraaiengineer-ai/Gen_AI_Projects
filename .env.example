# Copy to .env and fill in. Never commit .env.

ENVIRONMENT=local            # local | dev | staging | prod
LOG_LEVEL=INFO
LOG_FORMAT=text              # text | json (use json in containers)

# EURI (OpenAI-compatible gateway) for chat + embeddings
EURI_API_KEY=
LLM_BASE_URL=https://api.euron.one/api/v1/euri
LLM_MODEL=gpt-4.1-nano
LLM_TEMPERATURE=0.2                  # answers: 0.2-0.5 allowed (the evaluation judge always uses 0)
LLM_MAX_TOKENS=1024
LLM_MAX_RETRIES=1
EMBEDDING_MAX_RETRIES=4               # embeddings retry rate limits with backoff (no embedding fallback)
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3   # skip a provider:model after N consecutive outages...
CIRCUIT_BREAKER_RESET_SECONDS=60      # ...for this long, then try one trial call
LLM_FALLBACK_PROVIDER=euri           # euri | gemini (Google directly: still works when the EURI wallet is spent)
LLM_FALLBACK_MODEL=gemini-2.0-flash   # Quick answer fallback; empty disables. With gemini: gemini-3.5-flash
AGENT_FALLBACK_MODEL=gpt-4o-mini     # Research fallback; must support tool calling via EURI
# More fallbacks, tried in order after the above: comma-separated provider:model (euri|gemini|groq)
LLM_EXTRA_FALLBACKS=                 # e.g. groq:openai/gpt-oss-120b
AGENT_EXTRA_FALLBACKS=               # e.g. groq:openai/gpt-oss-120b (passes a real tool-call round trip)
EMBEDDING_PROVIDER=euri              # euri | gemini. Changing provider/model needs a new COLLECTION_NAME + re-upload
EMBEDDING_MODEL=text-embedding-3-small  # with gemini: gemini-embedding-001
EMBEDDING_DIM=1536           # must match EMBEDDING_MODEL; changing it needs a fresh collection

# Direct provider keys (only needed when a setting above names that provider)
GEMINI_API_KEY=
GROQ_API_KEY=

# Tavily web search: adds a search_web tool to the Research agent. Empty = knowledge base only.
TAVILY_API_KEY=
WEB_SEARCH_MAX_RESULTS=3
WEB_SEARCH_DEPTH=basic              # basic | advanced (2 credits per search)

# Postgres with pgvector.
# Local:    postgresql+psycopg://rag:rag@localhost:5432/rag
# Supabase: Project Settings -> Database -> Connection string (URI). postgresql:// URLs are accepted as-is.
DATABASE_URL=
COLLECTION_NAME=documents

# Chunking. Default strategy for /ingest (the UI and API can choose per upload):
#   recursive    fixed-size chunks on paragraph/sentence/word boundaries
#   semantic     split where the topic shifts; ~1 extra embedding per sentence at ingest
#   parent_child match on small child chunks, answer with their larger parent
#   table        split tables between rows with the header repeated; .csv/.tsv become tables
CHUNKING_STRATEGY=recursive
CHUNK_SIZE=1000                       # recursive chunk size, and the cap on semantic chunks
CHUNK_OVERLAP_PCT=15                  # % of chunk size; 15-20 for regular chunks
SEMANTIC_BREAKPOINT_PERCENTILE=90     # lower = more, smaller semantic chunks
PARENT_CHUNK_SIZE=2000
CHILD_CHUNK_SIZE=400
CHILD_CHUNK_OVERLAP_PCT=10            # % of child size; 10-15 for small parent-child children

# Uploads + golden dataset
MAX_UPLOAD_MB=20                      # per file; files are parsed in memory
GOLDEN_QUESTIONS_PER_DOCUMENT=3       # LLM-written eval Q&A per new/changed document; 0 disables
EVAL_JUDGE_MODEL=gpt-4o-mini          # grades answers in /eval; empty = LLM_MODEL

# Per-user requests per minute on quota-spending endpoints (0 = unlimited). In-memory, per pod.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_QUERY_PER_MINUTE=10
RATE_LIMIT_AGENT_PER_MINUTE=3
RATE_LIMIT_INGEST_PER_MINUTE=5
RATE_LIMIT_EVAL_PER_MINUTE=1

# Retrieval / agent
TOP_K=4
HYBRID_SEARCH=true                    # vector + BM25-style keyword search, fused with reciprocal rank fusion
RERANK_ENABLED=true                   # an LLM picks the best TOP_K of RERANK_CANDIDATES (1 LLM call per query)
RERANK_CANDIDATES=12
GUARDRAILS_ENABLED=true                # input / document / output checks per app/guardrails/policy.yaml
GUARDRAILS_POLICY_PATH=                # optional: your own policy file
OCR_ENABLED=true                      # read scanned PDF pages and image uploads with OCR
HALLUCINATION_GUARD=flag              # off | flag | block: citation + numbers/identifiers check on every answer
AGENT_MAX_ITERATIONS=6

# Cache + memory. Redis is optional locally (in-process fallback); compose and k8s run one.
REDIS_URL=                            # e.g. redis://localhost:6379/0
CACHE_ENABLED=true
ANSWER_CACHE_TTL_SECONDS=3600         # repeated questions (cleared whenever documents change)
PROMPT_CACHE_TTL_SECONDS=86400        # identical LLM prompts
MEMORY_WINDOW_MESSAGES=8              # recent messages used to understand follow-up questions
SHORT_TERM_MEMORY_TTL_SECONDS=3600    # Redis; long-term history is kept in Postgres
AUDIT_LOG_CONTENT=true                # include question/answer text in the audit log

# Auth: Supabase Auth. Users sign in on the UI; the API verifies their JWT against the project's JWKS.
# Admin role: set app_metadata.app_role = "admin" on the user in Supabase.
AUTH_ENABLED=true            # false only for local dev; refused in staging/prod
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=    # public by design (sb_publishable_...). Never put the secret key here.

# Local Grafana (docker compose --profile monitoring), user: admin
GRAFANA_ADMIN_PASSWORD=
