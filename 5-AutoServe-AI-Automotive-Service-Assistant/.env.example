# AutoServe AI — every backend variable. Copy to autoserve-server/.env and fill in secrets. NEVER commit real values.
# Synthetic data only. See .claude/adr/007 (Supabase) and 008 (LLM chains).

# ── App ──
APP_ENV=local                         # local | ci | dev | staging | prod
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# ── Database (ADR-007) ──
# Local Docker:  postgresql+asyncpg://autoserve:autoserve@localhost:5432/autoserve  (DATABASE_POOLER_MODE=direct)
# Supabase app:  postgresql+asyncpg://postgres.<project-ref>:<url-encoded-password>@<pooler-host>:6543/postgres (transaction)
DATABASE_URL=postgresql+asyncpg://autoserve:autoserve@localhost:5432/autoserve
DATABASE_POOLER_MODE=direct           # direct | session | transaction (transaction disables prepared statements)
# Migrations + LangGraph checkpointer need a session/direct connection (Supabase: same pooler host, port 5432)
DATABASE_URL_MIGRATIONS=
DB_CONNECT_TIMEOUT_S=5
# Supabase project info (reference only; app code uses no Supabase SDK/Auth)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# ── LLM providers (ADR-008) — OpenAI-compatible ──
LLM_PROVIDER=openai_compatible
EURI_API_KEY=
EURI_BASE_URL=https://api.euron.one/api/v1/euri
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# provider:model,... first = primary. AGENT = structured output/tools (no gemini). ANSWER = free text.
LLM_AGENT_CHAIN=euri:gpt-4.1-mini,groq:qwen/qwen3.8-27b,groq:openai/gpt-oss-20b
LLM_ANSWER_CHAIN=euri:gpt-4.1-mini,gemini:gemini-3.8-flash,groq:openai/gpt-oss-120b
LLM_TEMPERATURE=0.2                   # 0.2–0.5
LLM_TIMEOUT_S=30                       # primary model
LLM_FALLBACK_TIMEOUT_S=10             # fallback models (fail over fast)
LLM_MAX_RETRIES=2                     # ≤ 2
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536             # must match knowledge_chunks.embedding

# ── Optional integrations (ADR-008) ──
WEB_SEARCH_ENABLED=false              # must stay false (A1: corpus-only facts)
TAVILY_API_KEY=
TYPESAFE_API_KEY=                     # optional; intent routing only, never decisions
TYPESAFE_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest
DECISION_TIMEOUT_SECONDS=5

# ── Object storage ──
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=autoserve-documents
S3_ACCESS_KEY=autoserve
S3_SECRET_KEY=autoserve-local-only
S3_REGION=us-east-1
S3_SSE=none                           # none (local MinIO) | AES256 | aws:kms (prod)
S3_KMS_KEY_ID=
STORAGE_BACKEND=s3                    # s3 | local (tests/offline only)
LOCAL_STORAGE_DIR=.local-storage
MAX_UPLOAD_BYTES=10485760
MAX_UPLOAD_PAGES=20
EXTRACTION_CONFIDENCE_THRESHOLD=0.80
TESSERACT_CMD=                        # optional; e.g. C:\Program Files\Tesseract-OCR	esseract.exe

# ── Auth ──
AUTH_MODE=demo                        # demo (local JWT) | oidc (prod, Cognito)
JWT_SECRET=                           # long random string; local DEMO only
JWT_TTL_MINUTES=60

# ── Retention (days; P4-6) ──
RETENTION_DAYS_MESSAGES=180
RETENTION_DAYS_DOCUMENTS=730
RETENTION_DAYS_NOTIFICATIONS=90
RETENTION_DAYS_LLM_USAGE=365

# ── docker-compose overrides (root .env or shell) ──
# COMPOSE_DATABASE_URL=            # point the compose backend at Supabase instead of the local db
# COMPOSE_DATABASE_POOLER_MODE=transaction
# MINIO_ROOT_USER=autoserve
# MINIO_ROOT_PASSWORD=autoserve-local-only
# Host ports (change if another local project already uses them)
# AUTOSERVE_DB_PORT=5432
# AUTOSERVE_API_PORT=8000
# AUTOSERVE_WEB_PORT=5173
# AUTOSERVE_S3_PORT=9000
# AUTOSERVE_S3_CONSOLE_PORT=9001
