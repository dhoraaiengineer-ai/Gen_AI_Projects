# Copy to .env and fill in. Never commit .env. Every setting has a safe default unless marked REQUIRED.

# --- App ---
APP_ENV=local                 # local | test | production
APP_NAME=MedInfo Assistant
LOG_LEVEL=INFO
LOG_FORMAT=text               # text (local) | json (containers)
AUDIT_LOG_ENABLED=true        # audit lines never contain question/answer text

# --- Supabase auth (REQUIRED in production) ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...   # public by design (browser sign-in)
SUPABASE_SECRET_KEY=sb_secret_...             # server-side admin tasks only; never sent to the browser
SUPABASE_JWKS_URL=                            # optional; derived from SUPABASE_URL when empty
SUPABASE_JWT_AUDIENCE=authenticated
JWKS_CACHE_SECONDS=600

# --- Database (REQUIRED in production; readiness probe checks it) ---
# Supabase transaction pooler (port 6543). Use the postgresql+psycopg:// scheme.
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres

# --- Model providers (OpenAI-compatible) ---
EURI_API_KEY=
EURI_BASE_URL=https://api.euron.one/api/v1/euri
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Chains: provider:model in fallback order (Stage 1 uses only the first answer model).
LLM_ANSWER_CHAIN=euri:gpt-4.1-mini,gemini:<gemini-model>,groq:openai/gpt-oss-120b
# Agents (tool calling): Gemini excluded - its OpenAI-compatible API drops tool-call thought signatures.
LLM_AGENT_CHAIN=euri:gpt-4.1-mini,groq:<qwen-model>,groq:openai/gpt-oss-20b
# Optional cheaper/faster chain for triage, scope, rewrite and re-rank (LLM gateway route "fast").
# Empty = use LLM_ANSWER_CHAIN. Routing table and per-task token limits: backend/app/rag/llm_gateway.yaml
LLM_FAST_CHAIN=
LLM_TEMPERATURE=0.2           # answers only; enforced 0.1-0.3. Classifiers/judges are always 0.
LLM_TIMEOUT_SECONDS=45
LLM_MAX_TOKENS=1200

# --- Embeddings (one model per collection; changing it needs a new collection + re-ingest) ---
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# --- Web search (research mode; medical domain allow-list only) ---
TAVILY_API_KEY=

# --- Region and safety messaging ---
REGION=international
AUDIENCE=public               # public | clinician | mixed
EMERGENCY_NUMBER=112          # REQUIRED to be set explicitly in production
EMERGENCY_SERVICE_NAME=emergency services
CRISIS_LINE_NAME=             # e.g. the national suicide/crisis line name
CRISIS_LINE_NUMBER=
POISON_LINE_NUMBER=

# --- Safety thresholds (ops-tunable; the safety layer itself cannot be disabled) ---
STALE_SOURCE_YEARS=5
MAX_QUESTION_CHARS=2000

# --- Retrieval ---
RETRIEVAL_BACKEND=auto        # auto (pgvector if DATABASE_URL set, else static) | static | memory | pgvector
CORPUS_PATH=data/synthetic/stage1_corpus.json   # static backend only
RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATES=12       # hybrid candidates sent to the LLM re-ranker
RETRIEVAL_MIN_SCORE=0.5       # static BM25 backend
RETRIEVAL_MIN_SIMILARITY=0.25 # cosine floor for vector hits
RERANK_ENABLED=true
EMBEDDING_PROVIDER=euri       # collections are named per provider/model/dims, so models never mix
COLLECTION_PREFIX=medinfo

# --- Cache, memory, rate limits ---
REDIS_URL=                    # e.g. redis://:password@localhost:6379/0 ; unset -> in-process fallback (single replica)
ANSWER_CACHE_TTL_SECONDS=3600 # 0 disables; never caches emergency/refused/flagged/follow-up answers
LLM_CACHE_TTL_SECONDS=86400   # prompt cache; stores plain text only
EMBEDDING_CACHE_TTL_SECONDS=604800 # query-embedding cache (hash key, vectors only); 0 disables
CONVERSATION_RETENTION_DAYS=30
# Fernet key (REQUIRED in production): python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONVERSATION_ENCRYPTION_KEY=
SHORT_TERM_TURNS=10
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_RESEARCH_PER_HOUR=20
RATE_LIMIT_UPLOAD_PER_HOUR=30

# --- Observability / review ---
METRICS_TOKEN=                # if set, /metrics requires "Authorization: Bearer <token>"
REVIEW_SAMPLE_RATE=0.05       # share of live answers queued (redacted) for clinician review

# --- docker compose only ---
REDIS_PASSWORD=               # required by docker-compose.yml (Redis requires a password)
LOCAL_PG_PASSWORD=            # --profile pgvector
GRAFANA_ADMIN_PASSWORD=       # --profile monitoring

# --- Resilience ---
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_RESET_SECONDS=30
MODEL_RETRY_ATTEMPTS=2
MODEL_RETRY_BASE_DELAY=0.5

# --- Research mode (clinician/admin only; web search on an allow-list of medical domains) ---
RESEARCH_ENABLED=true
# JSON list; results from any other domain are dropped locally even if the provider returns them.
WEB_ALLOWED_DOMAINS=["who.int","nice.org.uk","cdc.gov","nih.gov","ncbi.nlm.nih.gov","medlineplus.gov","nhs.uk","fda.gov","ema.europa.eu","cochranelibrary.com"]

# --- Ingestion ---
CHUNK_STRATEGY=recursive      # recursive | semantic | parent_child (tables are always table-aware)
CHUNK_SIZE=1000               # 15% overlap
PARENT_CHUNK_SIZE=2000
CHILD_CHUNK_SIZE=400          # 10% overlap
MAX_UPLOAD_MB=10
