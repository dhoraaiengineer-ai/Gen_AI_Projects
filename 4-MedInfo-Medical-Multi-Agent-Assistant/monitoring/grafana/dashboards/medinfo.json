    {
      "id": 11,
      "type": "timeseries",
      "title": "Cache hit ratio",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (cache) (rate(medinfo_cache_events_total{result=\"hit\"}[15m])) / clamp_min(sum by (cache) (rate(medinfo_cache_events_total{result=~\"hit|miss\"}[15m])), 0.001)",
          "legendFormat": "{{cache}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "id": 12,
